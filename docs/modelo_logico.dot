digraph modelo_logico {
graph [rankdir=LR, bgcolor="white", pad=0.45, nodesep=0.7, ranksep=2.2, splines=polyline, fontname="DejaVu Sans", label="Cinthiê Confeitaria — Modelo lógico relacional\nPK = chave primária · FK = chave estrangeira\nCardinalidade junto à tabela: número de suas linhas para uma linha da tabela oposta", labelloc=t, fontsize=16];
node [shape=plain, fontname="DejaVu Sans", fontsize=11];
edge [dir=none, color="#64748b", fontname="DejaVu Sans", fontsize=11, labeldistance=2.2, labelangle=0];
cliente [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#173c52"><FONT COLOR="white"><B>CLIENTE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_cliente_in">id_cliente</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT" PORT="id_cliente_out">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="nome_cliente_in">nome_cliente</TD><TD ALIGN="LEFT">VARCHAR(120)</TD><TD ALIGN="LEFT" PORT="nome_cliente_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="telefone_cliente_in">telefone_cliente</TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD ALIGN="LEFT" PORT="telefone_cliente_out"></TD></TR></TABLE>>];
funcionario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#173c52"><FONT COLOR="white"><B>FUNCIONARIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_funcionario_in">id_funcionario</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT" PORT="id_funcionario_out">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="nome_funcionario_in">nome_funcionario</TD><TD ALIGN="LEFT">VARCHAR(120)</TD><TD ALIGN="LEFT" PORT="nome_funcionario_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="funcao_funcionario_in">funcao_funcionario</TD><TD ALIGN="LEFT">VARCHAR(80)</TD><TD ALIGN="LEFT" PORT="funcao_funcionario_out"></TD></TR></TABLE>>];
produto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#173c52"><FONT COLOR="white"><B>PRODUTO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_produto_in">id_produto</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT" PORT="id_produto_out">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="nome_produto_in">nome_produto</TD><TD ALIGN="LEFT">VARCHAR(120)</TD><TD ALIGN="LEFT" PORT="nome_produto_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="descricao_produto_in">descricao_produto</TD><TD ALIGN="LEFT">VARCHAR(300)</TD><TD ALIGN="LEFT" PORT="descricao_produto_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="preco_produto_in">preco_produto</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD><TD ALIGN="LEFT" PORT="preco_produto_out"></TD></TR></TABLE>>];
plataforma [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#173c52"><FONT COLOR="white"><B>PLATAFORMA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_plataforma_in">id_plataforma</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT" PORT="id_plataforma_out">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="nome_plataforma_in">nome_plataforma</TD><TD ALIGN="LEFT">VARCHAR(60)</TD><TD ALIGN="LEFT" PORT="nome_plataforma_out"></TD></TR></TABLE>>];
pedido [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#173c52"><FONT COLOR="white"><B>PEDIDO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_pedido_in">id_pedido</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT" PORT="id_pedido_out">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_cliente_in">id_cliente</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT" PORT="id_cliente_out">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_plataforma_in">id_plataforma</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT" PORT="id_plataforma_out">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="data_hora_pedido_in">data_hora_pedido</TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT" PORT="data_hora_pedido_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="data_prevista_atendimento_in">data_prevista_atendimento</TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT" PORT="data_prevista_atendimento_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="data_hora_cancelamento_in">data_hora_cancelamento</TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT" PORT="data_hora_cancelamento_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="status_pedido_in">status_pedido</TD><TD ALIGN="LEFT">VARCHAR(24)</TD><TD ALIGN="LEFT" PORT="status_pedido_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="canal_pedido_in">canal_pedido</TD><TD ALIGN="LEFT">VARCHAR(24)</TD><TD ALIGN="LEFT" PORT="canal_pedido_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo_pedido_in">tipo_pedido</TD><TD ALIGN="LEFT">VARCHAR(24)</TD><TD ALIGN="LEFT" PORT="tipo_pedido_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="modalidade_atendimento_in">modalidade_atendimento</TD><TD ALIGN="LEFT">VARCHAR(24)</TD><TD ALIGN="LEFT" PORT="modalidade_atendimento_out"></TD></TR></TABLE>>];
pagamento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#173c52"><FONT COLOR="white"><B>PAGAMENTO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_pagamento_in">id_pagamento</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT" PORT="id_pagamento_out">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_pedido_in">id_pedido</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT" PORT="id_pedido_out">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="data_pagamento_in">data_pagamento</TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT" PORT="data_pagamento_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="forma_pagamento_in">forma_pagamento</TD><TD ALIGN="LEFT">VARCHAR(24)</TD><TD ALIGN="LEFT" PORT="forma_pagamento_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="valor_pago_in">valor_pago</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD><TD ALIGN="LEFT" PORT="valor_pago_out"></TD></TR></TABLE>>];
item_pedido [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#173c52"><FONT COLOR="white"><B>ITEM_PEDIDO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_pedido_in">id_pedido</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT" PORT="id_pedido_out">PK, FK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_produto_in">id_produto</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT" PORT="id_produto_out">PK, FK</TD></TR><TR><TD ALIGN="LEFT" PORT="quantidade_in">quantidade</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT" PORT="quantidade_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="preco_unitario_in">preco_unitario</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD><TD ALIGN="LEFT" PORT="preco_unitario_out"></TD></TR></TABLE>>];
pedido_funcionario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#173c52"><FONT COLOR="white"><B>PEDIDO_FUNCIONARIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_funcionario_in">id_funcionario</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT" PORT="id_funcionario_out">PK, FK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_pedido_in">id_pedido</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT" PORT="id_pedido_out">PK, FK</TD></TR><TR><TD ALIGN="LEFT" PORT="papel_participacao_in">papel_participacao</TD><TD ALIGN="LEFT">VARCHAR(80)</TD><TD ALIGN="LEFT" PORT="papel_participacao_out"></TD></TR></TABLE>>];
estorno [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#173c52"><FONT COLOR="white"><B>ESTORNO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_estorno_in">id_estorno</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT" PORT="id_estorno_out">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_pagamento_in">id_pagamento</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT" PORT="id_pagamento_out">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="data_estorno_in">data_estorno</TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT" PORT="data_estorno_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="valor_estornado_in">valor_estornado</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD><TD ALIGN="LEFT" PORT="valor_estornado_out"></TD></TR></TABLE>>];
compra [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#173c52"><FONT COLOR="white"><B>COMPRA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_compra_in">id_compra</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT" PORT="id_compra_out">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="data_compra_in">data_compra</TD><TD ALIGN="LEFT">DATE</TD><TD ALIGN="LEFT" PORT="data_compra_out"></TD></TR></TABLE>>];
insumo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#173c52"><FONT COLOR="white"><B>INSUMO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_insumo_in">id_insumo</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT" PORT="id_insumo_out">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="nome_insumo_in">nome_insumo</TD><TD ALIGN="LEFT">VARCHAR(120)</TD><TD ALIGN="LEFT" PORT="nome_insumo_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="unidade_medida_in">unidade_medida</TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD ALIGN="LEFT" PORT="unidade_medida_out"></TD></TR></TABLE>>];
compra_insumo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#173c52"><FONT COLOR="white"><B>COMPRA_INSUMO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_compra_in">id_compra</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT" PORT="id_compra_out">PK, FK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_insumo_in">id_insumo</TD><TD ALIGN="LEFT">INT</TD><TD ALIGN="LEFT" PORT="id_insumo_out">PK, FK</TD></TR><TR><TD ALIGN="LEFT" PORT="quantidade_in">quantidade</TD><TD ALIGN="LEFT">DECIMAL(12,3)</TD><TD ALIGN="LEFT" PORT="quantidade_out"></TD></TR><TR><TD ALIGN="LEFT" PORT="custo_unitario_in">custo_unitario</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD><TD ALIGN="LEFT" PORT="custo_unitario_out"></TD></TR></TABLE>>];
cliente:id_cliente_out:e -> pedido:id_cliente_in:w [taillabel="(0, 1)", headlabel="(0, n)"];
plataforma:id_plataforma_out:e -> pedido:id_plataforma_in:w [taillabel="(0, 1)", headlabel="(0, n)"];
pedido:id_pedido_out:e -> pagamento:id_pedido_in:w [taillabel="(1, 1)", headlabel="(0, n)", labelangle=35];
pedido:id_pedido_out:e -> item_pedido:id_pedido_in:w [taillabel="(1, 1)", headlabel="(1, n)", labelangle=-15, labeldistance=7];
produto:id_produto_out:e -> item_pedido:id_produto_in:w [taillabel="(1, 1)", headlabel="(0, n)"];
funcionario:id_funcionario_out:e -> pedido_funcionario:id_funcionario_in:w [taillabel="(1, 1)", headlabel="(0, n)", labelangle=25];
pedido:id_pedido_out:e -> pedido_funcionario:id_pedido_in:w [taillabel="(1, 1)", headlabel="(0, n)", labelangle=-20, labeldistance=12];
pagamento:id_pagamento_out:e -> estorno:id_pagamento_in:w [taillabel="(1, 1)", headlabel="(0, 1)"];
compra:id_compra_out:e -> compra_insumo:id_compra_in:w [taillabel="(1, 1)", headlabel="(1, n)"];
insumo:id_insumo_out:e -> compra_insumo:id_insumo_in:w [taillabel="(1, 1)", headlabel="(0, n)"];
}
